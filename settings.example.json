{
  "hotkey": "Win+Space",
  "theme": "dark",
  "accent_color": "#9A8CFF",
  "max_results": 9,
  "window_width": 720,
  "clipboard_enabled": false,
  "max_clipboard_entries": 30,
  "max_indexed_files": 20000,
  "file_roots": [
    "%USERPROFILE%\\Documents",
    "%USERPROFILE%\\Downloads",
    "%USERPROFILE%\\Desktop"
  ],
  "web_search_template": "https://www.google.com/search?q={query}",
  "commands": [
    {
      "name": "PowerShell",
      "file_name": "powershell.exe",
      "arguments": "-NoLogo -NoProfile"
    },
    {
      "name": "Bloc-notes",
      "file_name": "notepad.exe",
      "arguments": ""
    }
  ]
}
